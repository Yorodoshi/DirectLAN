<Window x:Class="DirectLAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DirectLAN" Width="1280" Height="820" MinWidth="1040" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#0B1220" Foreground="#E6EDF7"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#142033" />
    <SolidColorBrush x:Key="BorderBrush" Color="#273750" />
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9AAEC8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="ValueStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F6FC" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="#254269" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#42618B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#2F73C7" />
      <Setter Property="BorderBrush" Value="#4A92E4" />
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="DirectLAN" FontSize="29" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="Защищённый туннель между вашими устройствами · Direct или HTTPS Relay" Foreground="#9AAEC8" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="ServiceIndicator" Width="10" Height="10" Fill="#E5A64A" Margin="0,0,8,0" />
        <TextBlock x:Name="ServiceText" Text="Подключение к службе…" VerticalAlignment="Center" Margin="0,0,18,0" />
        <Button x:Name="RefreshButton" Content="Обновить" Style="{StaticResource ActionButton}" Click="RefreshButton_Click" />
      </StackPanel>
    </Grid>

    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,-12,18">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel><TextBlock Text="Группа" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="GroupNameText" Text="—" Style="{StaticResource ValueStyle}" Margin="0,8,0,0" /></StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel><TextBlock Text="Виртуальный IP" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="VirtualIpText" Text="—" Style="{StaticResource ValueStyle}" Margin="0,8,0,0" /></StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel><TextBlock Text="Канал" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="ConnectionText" Text="—" Style="{StaticResource ValueStyle}" Margin="0,8,0,0" /></StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel><TextBlock Text="Выход транспорта" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="EgressText" Text="—" Style="{StaticResource ValueStyle}" Margin="0,8,0,0" /></StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel><TextBlock Text="Адаптер" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="ActiveAdapterText" Text="—" Style="{StaticResource ValueStyle}" Margin="0,8,0,0" /></StackPanel>
      </Border>
    </UniformGrid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Участники" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Разрешённые устройства и состояние соединения" Style="{StaticResource LabelStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="CheckButton" Grid.Column="1" Content="Проверить связь" Style="{StaticResource PrimaryButton}" Click="CheckButton_Click" />
          </Grid>

          <WrapPanel Grid.Row="1" Margin="0,18,0,12">
            <Button x:Name="CreateGroupButton" Content="Создать группу" Style="{StaticResource ActionButton}" Click="CreateGroupButton_Click" />
            <Button x:Name="InviteButton" Content="Пригласить" Style="{StaticResource ActionButton}" Click="InviteButton_Click" />
            <Button x:Name="JoinButton" Content="Вступить по коду" Style="{StaticResource ActionButton}" Click="JoinButton_Click" />
            <Button x:Name="CopyIpButton" Content="Копировать IP" Style="{StaticResource SmallButton}" Click="CopyIpButton_Click" />
          </WrapPanel>

          <DataGrid x:Name="MembersGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                    GridLinesVisibility="None" Background="#142033" Foreground="White"
                    BorderThickness="0" RowBackground="#142033" AlternatingRowBackground="#1A2B41"
                    AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    SelectionChanged="MembersGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#20314A" /><Setter Property="Foreground" Value="#C8D7EA" />
                <Setter Property="Padding" Value="9,9" /><Setter Property="BorderThickness" Value="0" />
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#E6EDF7" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,8" />
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Устройство" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="Виртуальный IP" Binding="{Binding OverlayIp}" Width="*" />
              <DataGridTextColumn Header="Доступ" Binding="{Binding ApprovalText}" Width="*" />
              <DataGridTextColumn Header="Канал" Binding="{Binding State}" Width="*" />
              <DataGridTextColumn Header="Выход" Binding="{Binding Egress}" Width="*" />
              <DataGridTextColumn Header="RTT" Binding="{Binding Rtt}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>

          <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="SelectedMemberText" Text="Выберите участника" Foreground="#9AAEC8" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="FingerprintText" Text="" Foreground="#9AAEC8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="ApproveButton" Content="Подтвердить" Style="{StaticResource SmallButton}" Click="ApproveButton_Click" />
              <Button x:Name="RevokeButton" Content="Удалить доступ" Style="{StaticResource SmallButton}" Click="RevokeButton_Click" Margin="0" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Показатели соединения" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
            <UniformGrid Columns="2" Rows="2">
              <StackPanel Margin="0,0,8,10"><TextBlock Text="RTT" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="RttText" Text="—" Style="{StaticResource ValueStyle}" /></StackPanel>
              <StackPanel Margin="0,0,0,10"><TextBlock Text="Jitter" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="JitterText" Text="—" Style="{StaticResource ValueStyle}" /></StackPanel>
              <StackPanel Margin="0,0,8,0"><TextBlock Text="Потери" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="LossText" Text="—" Style="{StaticResource ValueStyle}" /></StackPanel>
              <StackPanel><TextBlock Text="Скорость" Style="{StaticResource LabelStyle}" /><TextBlock x:Name="SpeedText" Text="—" Style="{StaticResource ValueStyle}" /></StackPanel>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Исходящий адаптер" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="Физический Ethernet или Wi-Fi для транспорта DirectLAN" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <ComboBox x:Name="AdapterCombo" Height="32" DisplayMemberPath="Name" SelectedValuePath="Id"
                      Background="White" Foreground="#182235" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SelectAdapterButton" Content="Выбрать" Style="{StaticResource PrimaryButton}" Click="SelectAdapterButton_Click" />
              <Button x:Name="LoadAdaptersButton" Content="Обновить список" Style="{StaticResource ActionButton}" Click="LoadAdaptersButton_Click" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="События и ошибки" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="ExportButton" Grid.Column="1" Content="Экспорт диагностики" Style="{StaticResource SmallButton}" Margin="0" Click="ExportButton_Click" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="EventsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,11">
                      <TextBlock Text="{Binding Header}" Foreground="#9AAEC8" FontSize="11" />
                      <TextBlock Text="{Binding Message}" Foreground="#E6EDF7" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterText" Text="Ожидание ответа службы" Foreground="#9AAEC8" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="DirectLAN · локальный IPC v1" Foreground="#657B98" FontSize="11" />
    </Grid>
  </Grid>
</Window>
