<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DirectLAN</AssemblyName>
    <Version>0.3.3</Version>
    <ApplicationIcon>Assets\DirectLAN.ico</ApplicationIcon>
    <RootNamespace>DirectLAN</RootNamespace>
	<RuntimeFrameworkVersion>10.0.8</RuntimeFrameworkVersion>
	<Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\DirectLAN.ico"/>
    <Resource Include="Assets\DirectLANMark.png"/>
  </ItemGroup>
</Project>
