<Window x:Class="DirectLAN.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запуск DirectLAN" Width="760" Height="740" MinWidth="660" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0B1220" Foreground="#E6EDF7" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Foreground" Value="#E6EDF7"/></Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="DirectLAN" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="Запуск двойным щелчком · без PowerShell" Foreground="#A8BCD4" Margin="0,5,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel x:Name="ConfigurationPanel">
          <CheckBox x:Name="ServerMode" Content="Этот ПК — сервер и первый участник" Checked="ModeChanged" Unchecked="ModeChanged"/>
          <StackPanel x:Name="ServerPanel">
            <TextBlock Text="Адрес этого ПК в локальной сети"/>
            <ComboBox x:Name="ServerAddress" IsEditable="True" Margin="0,5,0,14" Padding="8"/>
            <TextBlock Text="Порт HTTPS-сервера"/>
            <TextBox x:Name="ServerPort" Text="4433"/>
            <CheckBox x:Name="StartLocalClient" IsChecked="True" Content="Также запустить клиент на этом ПК"/>
          </StackPanel>
          <StackPanel x:Name="ClientPanel">
            <TextBlock Text="Адрес первого ПК или сервера"/>
            <TextBox x:Name="CoordinatorUrl" ToolTip="Например: https://192.168.1.10:4433"/>
            <TextBlock Text="CA-сертификат с первого ПК"/>
            <DockPanel Margin="0,5,0,14">
              <Button DockPanel.Dock="Right" Content="Выбрать…" Click="BrowseCA" Margin="10,0,0,0"/>
              <TextBox x:Name="CAPath" Margin="0" VerticalContentAlignment="Center"/>
            </DockPanel>
          </StackPanel>
          <TextBlock Text="Транспорт"/>
          <ComboBox x:Name="Transport" SelectedIndex="0" Padding="8" Margin="0,5,0,14">
            <ComboBoxItem Content="HTTPS Relay — по умолчанию" Tag="https"/>
            <ComboBoxItem Content="Сначала Direct, затем HTTPS Relay" Tag="auto"/>
            <ComboBoxItem Content="Только Direct (для проверки LAN)" Tag="direct"/>
          </ComboBox>
          <CheckBox x:Name="ConfigureFirewall" IsChecked="True" Content="Создать временные правила только для DirectLAN"/>
          <CheckBox x:Name="AutoStart" IsChecked="True" Content="В следующий раз запускать сразу" ToolTip="Удерживайте Shift при открытии, чтобы сначала изменить настройки."/>
          <TextBlock Text="Windows запросит права администратора для сетевой службы. Основной интерфейс останется без повышения прав." Foreground="#A8BCD4" Margin="0,0,0,16"/>
        </StackPanel>
        <Border x:Name="ServerInfoPanel" Visibility="Collapsed" Background="#16253B" Padding="14" Margin="0,0,0,15">
          <StackPanel>
            <TextBlock x:Name="ServerInfo"/>
            <TextBlock x:Name="Fingerprint" FontSize="11" Foreground="#A8BCD4" Margin="0,7,0,12"/>
            <Button x:Name="ExportCAButton" Content="Сохранить ca.pem для второго ПК…" Click="ExportCA" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Text="Выберите роль этого ПК и нажмите «Запустить»." Margin="0,0,0,12"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,15,0,0">
      <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,14"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="StartButton" Content="Запустить" Click="StartClicked" Background="#2F73C7" Foreground="White"/>
        <Button x:Name="OpenButton" Content="Открыть DirectLAN" Click="OpenMain" IsEnabled="False"/>
        <Button x:Name="StopButton" Content="Остановить" Click="StopClicked" IsEnabled="False"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
